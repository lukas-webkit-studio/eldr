{
  "name": "eldr",
  "version": "1.0.0",
  "description": "Vlastní kód webu eldr.cz — modulární zdroj v src/, sloučený bundle v dist/",
  "main": "index.js",
  "scripts": {
    "build": "node build.js",
    "test": "node test/smoke.js",
    "lint": "npx eslint src/modules build.js test",
    "prettier": "npx prettier src build.js test --check",
    "format": "npx prettier src build.js test --write && npm run lint",
    "check": "npm run build && npm run test && npm run lint"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-recommended": "^4.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "jsdom": "^24.1.3",
    "node-fetch": "^2.6.1"
  }
}