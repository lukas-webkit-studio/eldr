  {
   "type": "p",
   "text": "Sehen Sie sich genauer an, was Sie interessiert. Denken Sie daran, alles lässt sich anpassen:",
   "anchor": null
  },
  {
   "type": "img",
   "src": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6aa30c047763a83709200678_Image%20(Replace)%20(10).png",
