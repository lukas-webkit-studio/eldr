  {
   "type": "div",
   "text": "Interiér",
   "anchor": "designove-obrazy"
  },
  {
   "type": "div",
   "text": "Na míru",
   "anchor": "designove-obrazy"
  },
  {
   "type": "h2",
   "text": "Designové obrazy",
   "anchor": "designove-obrazy"
  },
  {
   "type": "p",
   "text": "Navrhujeme a vyrábíme velkoformátové obrazy a nástěnné grafiky pro restaurace, kavárny, retail i firemní prostory – od stylových ilustrací přes výrazné brandové motivy.",
   "anchor": "designove-obrazy"
  },
  {
   "type": "li",
   "text": "Materiály a tisk: tiskneme na plátno (canvas), fólie i pevné desky jako Dibond či PVC, dodáváme obrazy v hliníkových i dřevěných rámech nebo v bezrámovém provedení.",
   "anchor": "designove-obrazy"
  },
  {
   "type": "li",
   "text": "Zpracování: zajišťujeme grafický návrh, precizní velkoformátový tisk ve vysokém rozlišení i profesionální montáž – vše přizpůsobujeme konkrétnímu prostoru, světlu i identitě značky.",
   "anchor": "designove-obrazy"
  },
  {
   "type": "li",
   "text": "Výsledek: vizuální prvek, který posiluje atmosféru, podporuje značku a dělá z interiéru místo, které si zákazníci pamatují i fotí.",
   "anchor": "designove-obrazy"
  },
  {
   "type": "a",
   "text": "Nezávazně poptat",
   "anchor": "designove-obrazy"
  },
  {
   "type": "img",
   "src": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6aa30fdf719b2d58cd0d442c_designove-obrazy.jpg",
   "alt": "Designové obrazy na stěně kavárny",
   "anchor": "designove-obrazy"
  },
  {
   "type": "h2",
   "text": "Jak probíhá výroba světelné reklamy?",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "div",
   "text": "První krok je na vás, poté se o vše postaráme my.",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "a",
   "text": "Poptat výrobu",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "h3",
   "text": "Obdržíme poptávku",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Po telefonu: +420 491 482 500 (Po - Pá 6:00 - 15:00)",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Po mailu: eldr@eldr.cz",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Přes kontaktní formulář",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "h3",
   "text": "Do 2 pracovních dní: Pošleme odhad ceny",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Cenový odhad pošleme na základě obdobných realizací, kterých fotografie přiložíme.",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Doptáme se na potřebné detaily (velikost, umístění, grafika, podkladní plocha, materiál, zájem o vytvoření designu).",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "h3",
   "text": "Obratem: Dodáme závaznou nabídku na míru",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Nabídku vytvoříme zcela zdarma.",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Nabídka je včetně montáže a dopravy.",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Nabídku je možné v případě potřeby upravit.",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "h3",
   "text": "Do 4-8 týdnů: Instalujeme",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Dorazíme na dohodnuté místo instalace a umístíme reklamu.",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "li",
   "text": "Zprovozníme reklamu připojením k elektrické síti.",
   "anchor": "jak-probiha-vyroba"
  },
  {
   "type": "h2",
   "text": "Důvěřují nám přední české i zahraniční firmy",
   "anchor": "duvera"
  },
  {
   "type": "p",
   "text": "Spolehněte se na osvědčenou kvalitu a přidejte se k těm, kteří nám již důvěřují. Ozveme se vám nejpozději do následujícího pracovního dne.",
   "anchor": "duvera"
  },
  {
   "type": "a",
   "text": "Získat cenovou nabídku",
   "anchor": "duvera"
  },
  {
   "type": "a",
   "text": "Zobrazit reference",
   "anchor": "duvera"
  },
  {
   "type": "h2",
   "text": "Elektro Drapač je zárukou prvotřídní kvality",
   "anchor": "zaruka-kvality"
  },
  {
   "type": "p",
   "text": "Nejdéle působící výrobci světelné reklamy v Česku.",
   "anchor": "zaruka-kvality"
  },
  {
   "type": "p",
   "text": "Kvalitní materiály a úsporné LED diody, které vydrží svítit dlouhé roky.",
   "anchor": "zaruka-kvality"
  },
  {
   "type": "p",
   "text": "Výroba naší světelné reklamy probíhá kompletně v Česku.",
   "anchor": "zaruka-kvality"
  },
  {
   "type": "p",
   "text": "Poskytujeme profesionální instalaci a servis.",
   "anchor": "zaruka-kvality"
  },
  {
   "type": "p",
   "text": "Světelnou reklamu navrhneme na míru podle firemní identity.",
   "anchor": "zaruka-kvality"
  },
  {
   "type": "img",
   "src": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6705a6a48e1552c11127cc2e_eldr-emailing-logo.webp",
   "alt": "",
   "anchor": "zaruka-kvality"
  },
  {
   "type": "div",
   "text": "Kompletní úsporná řešení světelné reklamy od designu až po montáž.",
