        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/produkty/velkoformatovy-tisk#uvod",
              "name": "Velkoformátový digitální tisk",
              "description": "Lze detailně vyhotovit jakýkoliv design a barevnou kombinaci.",
              "url": "https://www.eldr.cz/produkty/velkoformatovy-tisk#uvod",
              "image": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6aa30fdff699af8129717988_uvod.jpg",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Materiály",
                  "value": "je možné potisknout papír, samolepicí fólii, translucentní (prosvětlovací) fólii, perforovanou fólii, banner a textilní materiály."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Zpracování",
                  "value": "latexový digitální tisk s možností detailního zpracování jakéhokoliv designu a barevné kombinace. Tisky laminujeme lesklou nebo matnou laminovací fólií, která zvyšuje odolnost zejména venku. Za stálobarevnost tisků ručíme minimálně po dobu tří let."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Provedení",
                  "value": "Digitální tisk často kombinujeme s řezanou grafikou"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Provedení",
                  "value": "Laminace chrání reklamu rovněž před mechanickým poškozením"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Použití",
                  "value": "Interiér i exteriér"
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/produkty/velkoformatovy-tisk#rezana-grafika",
              "name": "Řezaná grafika",
              "description": "Řezanou grafikou rozumíme nápisy vyřezané ze samolepicí fólie.",
              "url": "https://www.eldr.cz/produkty/velkoformatovy-tisk#rezana-grafika",
              "image": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6aa30fdf294524812b82d670_rezana-grafika.jpg",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Materiály",
                  "value": "samolepicí barevné fólie vhodné pro aplikaci na širokou škálu povrchů. Používané fólie mají stálobarevnost až sedm let."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Zpracování",
                  "value": "nápis je plotrem vyřezán do požadovaného tvaru a následně aplikován na podkladovou plochu – tou může být téměř jakýkoliv povrch s dostatečnou přilnavostí. Neumožňuje zhotovení například barevných přechodů a složitějších motivů v takové kvalitě jako digitální tisk. V případě potřeby proto tyto dvě techniky kombinujeme."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Provedení",
                  "value": "Výhodou řezané grafiky je její dlouhá životnost."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Použití",
                  "value": "Je vhodná na všechny typy reklamních a informačních nápisů."
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
