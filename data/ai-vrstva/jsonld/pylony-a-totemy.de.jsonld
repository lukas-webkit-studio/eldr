    {
      "@type": "Service",
      "@id": "https://www.eldr.cz/de/produkty/pylony-a-totemy#sluzba",
      "name": "Werbepylone und Totems",
      "description": "Herstellung von Leuchtreklamen mit hochwertiger Verarbeitung und Design, das auf Ihre Bedürfnisse zugeschnitten ist.",
      "provider": {
        "@type": "Organization",
        "@id": "https://www.eldr.cz/#organization"
      },
      "url": "https://www.eldr.cz/de/produkty/pylony-a-totemy",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Die Höhe der Werbetürme",
          "value": "von 1 bis 40 Metern"
        },
        {
          "@type": "PropertyValue",
          "name": "Herstellung von Werbepylonen und Totems von A bis Z",
          "value": "Wir können Werbepylone und Totems komplett schlüsselfertig realisieren oder in jeder Phase in ein laufendes Projekt einsteigen. Wir erstellen die Projektplanung, Visualisierung, statischen Berechnungen, Materialzertifikate und Fertigungsunterlagen. Außerdem kümmern wir uns um Lichtstudien und Prüfungen. Bei der Projektvorbereitung können wir mithilfe unserer Hebetechnik die Position und Höhe des Totems direkt vor Ort simulieren."
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "@id": "https://www.eldr.cz/de/produkty/pylony-a-totemy#katalog",
        "name": "Werbepylone und Totems",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/de/produkty/pylony-a-totemy#pylony",
              "name": "Pylone",
              "description": "Werbung mit dem Firmenlogo auf einer beliebig hohen Stahlkonstruktion an einem geeigneten Standort. Auch aus großer Entfernung gut sichtbar und daher sehr wirkungsvoll.",
              "url": "https://www.eldr.cz/de/produkty/pylony-a-totemy#pylony",
              "image": "https://cdn.prod.website-files.com/637cd69d722176059a46c1fb/6564a17b135f506b8f149faa_648b93d0e4fd3f1c74afa950_Sve%25CC%258Ctelny%25CC%2581%2520pylon%2520(1).webp",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Grafik",
                  "value": "Die Krone des Pylons ist der zentrale Teil, an dem beleuchtete oder unbeleuchtete Werbung, Schriftzüge oder Logos angebracht werden können. Die Krone kann einseitig, beidseitig, dreieckig oder quadratisch sein."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "Der Fuß des Pylons ist zur Verhinderung von Korrosion feuerverzinkt oder mit einer Korrosionsschutzbeschichtung versehen. Die Lichtpaneele sind mit energiesparenden LED-Dioden ausgestattet."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Aufstellung",
                  "value": "Kennzeichnung von Hypermärkten, Einkaufszentren, Firmensitzen und Tankstellen. Für die Verankerung ist gemäß statischer Berechnung ein Betonfundament erforderlich. Für mehr Sicherheit und besseren Service können Wartungsstege angebracht werden."
                },
                {
                  "@type": "PropertyValue",
