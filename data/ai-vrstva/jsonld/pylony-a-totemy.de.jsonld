          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/de/produkty/pylony-a-totemy#totemy",
              "name": "Totems",
              "description": "Werbung, die auf der Straße Aufmerksamkeit erregt und gleichzeitig als Orientierungspunkt dient, erleichtert die Fortbewegung in der Umgebung und sorgt für eine einfache Navigation.",
              "url": "https://www.eldr.cz/de/produkty/pylony-a-totemy#totemy",
              "image": "https://cdn.prod.website-files.com/637cd69d722176059a46c1fb/6564a1fbe13855e17ee6d891_648b94c3ab4adc28ad1284d6_Sve%25CC%258Ctelny%25CC%2581%2520totem%2520(0001).webp",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Grafik",
                  "value": "Kann Texte, Logos und Bilder enthalten, die so gestaltet sind, dass sie Aufmerksamkeit erregen. Die Beleuchtung erfolgt durch energiesparende LEDs. Die Totems können geformt, gewölbt oder mit 3D-Beschriftungen ergänzt werden."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "Verankerung im Betonfundament. Für kleinere Totems genügt eine Aluminiumkonstruktion oder eine feuerverzinkte Stahlkonstruktion. Die Verkleidung kann je nach Kundenwunsch aus Acrylat, Verbundwerkstoff oder Aluminiumblech bestehen."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Aufstellung",
                  "value": "an Zufahrtsstraßen, an Einfahrten zu Geländen, Tankstellen, Kaufhäusern oder überall dort, wo Beschilderung und Navigation erforderlich sind. Dienen auch als Orientierungssysteme für Betriebe und Innenräume."
                },
                {
