      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "Projecting signs of every type, made to measure",
          "value": "We produce them in a wide range of designs, variants and shapes. A projecting sign can be square or round, or shaped exactly as you like – a tooth for a dental surgery, for example."
        }
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
