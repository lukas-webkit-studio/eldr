              "@id": "https://www.eldr.cz/en/produkty/vystrce-lekarenske-znaky#vystrce",
              "name": "Illuminated projecting signs",
              "description": "Advertising that shines day and night. LED backlighting ensures consistent visibility whatever the weather.",
              "url": "https://www.eldr.cz/en/produkty/vystrce-lekarenske-znaky#vystrce",
              "image": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6aa30fde9a38c372ef8c1437_vystrce.jpg",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Graphics",
                  "value": "The face of the sign is covered with printed or plotter-cut graphics. Both the shape of the sign and the graphic design can be adapted exactly as you like, including custom shapes."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "The frame is an aluminium structure and the face is made of backlit acrylic glass or another sheet material. Brackets for fixing the sign to the wall are welded to the inner frame."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Suitable for",
                  "value": "Premises that need to be seen from every side – shops on busy streets, restaurants, hotels and anywhere advertising has to attract attention after dark."
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
