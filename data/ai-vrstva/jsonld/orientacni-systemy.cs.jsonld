      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "K čemu slouží orientační systémy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Je to soustava informačních tabulí, ukazatelů a cedulek, která usnadňuje pohyb osob. Pomáhá návštěvníkům rychle pochopit strukturu prostoru a najít správný směr bez nutnosti ptát se obsluhy."
          }
        },
        {
          "@type": "Question",
          "name": "Z čeho se vyrábějí orientační systémy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Z hliníkového, dibondového nebo akrylátového deskového materiálu. Oblíbeným materiálem s velice efektním vzhledem je eloxovaný hliník. Je možné využít i další materiály – dřevo, nerez, plexisklo."
          }
        }
      ]
    }
