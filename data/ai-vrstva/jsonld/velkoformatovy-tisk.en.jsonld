      },
      "url": "https://www.eldr.cz/en/produkty/velkoformatovy-tisk",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "@id": "https://www.eldr.cz/en/produkty/velkoformatovy-tisk#katalog",
        "name": "Large-format digital printing, plotter-cut graphics and decals",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/en/produkty/velkoformatovy-tisk#uvod",
              "name": "Large-format digital printing",
              "description": "Any design and colour combination, reproduced down to the detail.",
              "url": "https://www.eldr.cz/en/produkty/velkoformatovy-tisk#uvod",
              "image": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6aa30fdff699af8129717988_uvod.jpg",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Materials",
                  "value": "we can print on paper, self-adhesive film, translucent (backlighting) film, perforated film, banner and textile materials."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Processing",
                  "value": "latex digital printing that reproduces any design and colour combination down to the smallest detail. We laminate the prints with a gloss or matt laminating film, which increases resistance above all outdoors. We guarantee the colour fastness of our prints for at least three years."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "We often combine digital printing with plotter-cut graphics"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "Lamination also protects the advertisement against mechanical damage"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Use",
                  "value": "Indoors and outdoors"
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/en/produkty/velkoformatovy-tisk#rezana-grafika",
              "name": "Plotter-cut graphics",
              "description": "By plotter-cut graphics we mean lettering cut out of self-adhesive film.",
              "url": "https://www.eldr.cz/en/produkty/velkoformatovy-tisk#rezana-grafika",
              "image": "https://cdn.prod.website-files.com/635940ec249b210e8902edd4/6aa30fdf294524812b82d670_rezana-grafika.jpg",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Materials",
                  "value": "coloured self-adhesive films suitable for application to a wide range of surfaces. The films we use stay colour-fast for up to seven years."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Processing",
                  "value": "the lettering is cut to the required shape on a plotter and then applied to the base surface – which can be almost any surface with sufficient adhesion. It cannot produce colour gradients or more complex motifs at the quality digital printing achieves. Where needed, we therefore combine the two techniques."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Use",
                  "value": "advertising and information lettering"
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
