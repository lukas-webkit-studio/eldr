              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Grafika",
                  "value": "na prosvětlovací plochu lze aplikovat tištěnou nebo řezanou grafiku. Tyto grafické možnosti umožňují přizpůsobení vzhledu panelu podle potřeby a specifických požadavků."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Materiál",
                  "value": "hliníkový rám a zadní strana z hliníku nebo sendvičové desky. Přední plocha z plexiskla nebo prosvětlovací vinylové plachty, která zajišťuje dlouhou životnost a kvalitní prosvětlení."
                },
                {
                  "@type": "PropertyValue",
