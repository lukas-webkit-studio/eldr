    {
      "@type": "FAQPage",
      "@id": "https://www.eldr.cz/en/produkty/designova-a-interierova-svitidla-specialni-projekty#faq",
      "inLanguage": "en",
      "isPartOf": {
        "@id": "https://www.eldr.cz/en/produkty/designova-a-interierova-svitidla-specialni-projekty#webpage"
      },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do traditional neon signs work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Classic neon signs are made of glass tubes shaped under heat which, once filled with gas, glow red. Other light colours are achieved by filling the tube with phosphor powder and argon. Each tube carries a welded-on electrode connected to a high-voltage transformer, insulated with a silicone sleeve."
          }
        },
        {
          "@type": "Question",
          "name": "Why do we recommend neon sign imitations instead?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because they deliver a luxurious look at an affordable price. Traditional neon signs are beautiful, but they come with drawbacks such as a higher purchase price, demanding maintenance and high energy consumption. Modern neon sign imitations, however, offer the same visual effect at a substantially lower price."
          }
        }
      ]
    }
