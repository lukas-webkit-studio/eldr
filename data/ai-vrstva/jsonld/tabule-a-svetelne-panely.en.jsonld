      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "@id": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#katalog",
        "name": "Illuminated panels and boards",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#svetelne-panely",
              "name": "Illuminated panels",
              "description": "A box with an aluminium frame whose front face is made of a translucent material.",
              "url": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#svetelne-panely",
              "image": "https://cdn.prod.website-files.com/637cd69d722176059a46c1fb/6564a17f2298e32104ea8387_64914456ce1ed295b0e48957_Sve%25CC%258Ctelny%25CC%2581%2520panel%2520().webp",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Graphics",
                  "value": "printed or cut graphics can be applied to the translucent surface. These options let you adapt the look of the panel to your needs and specific requirements."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "aluminium frame and a back panel of aluminium or sandwich board. Front face of acrylic glass or translucent vinyl canvas"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Placement",
                  "value": "illuminated panels are easy to mount on buildings or pylons."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "in sizes up to 100 m²"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "Several versions are available, including vinyl canvas and acrylic glass panels and a version with 3D lettering."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "Illuminated face"
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#intarzie",
              "name": "Acrylic glass inlays",
              "description": "An inlay is an illuminated panel with protruding or recessed characters.",
              "url": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#intarzie",
              "image": "https://cdn.prod.website-files.com/637cd69d722176059a46c1fb/6564a105a11d00d56e90552c_6492100095d82614b3c59ea3_Plexintarzie%2520(00001).webp",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Graphics",
                  "value": "the better choice for small signs set in very fine typefaces, which could not be shaped as a standalone 3D sign."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "the body is formed by an aluminium frame and back panel. The front face is covered with an opaque board, usually sheet metal or a sandwich board – Dibond."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Placement",
                  "value": "an advantage on historic buildings, for example, where drilling into the façade is not possible – the power supply runs to a single point only."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "protruding or backed"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "The two versions differ in look and in price. It comes down to whether the characters sit above the surface of the panel or below it."
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#vystoupla-plexi-intarzie",
              "name": "Protruding acrylic glass inlay",
              "description": "The characters sit above the panel surface and create a 3D effect.",
              "url": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#intarzie",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "illuminated characters of solid acrylic glass"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "Openings are cut into the front face and illuminated characters of solid acrylic glass are set into them."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "The illuminated sides of the letters create an aura of light."
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@type": "Service",
              "@id": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#podlozena-plexi-intarzie",
              "name": "Backed acrylic glass inlay",
              "description": "The characters sit below the panel surface.",
              "url": "https://www.eldr.cz/en/produkty/tabule-a-svetelne-panely#intarzie",
              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "This is the more economical option, because the characters do not have to be shaped and production is less labour-intensive."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "This version does not create an aura of light."
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
