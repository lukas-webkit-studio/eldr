              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Graphics",
                  "value": "they let you display current offers using interchangeable artwork. The graphics are easy to change and adapt."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "The materials are designed for changing graphics and for use in restaurants."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Placement",
                  "value": "used above all in fast-food restaurants, where they display the current food and drink offer."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "They can be double-sided for easy changing."
                }
              ],
              "provider": {
