              "additionalProperty": [
                {
                  "@type": "PropertyValue",
                  "name": "Graphics",
                  "value": "the message on the surface can be produced with printed or cut graphics, sandblasting and engraving."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Material",
                  "value": "these are non-illuminated panels made from a range of materials such as aluminium, stainless steel, brass, composite materials, acrylates, glass, wood and the like."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Placement",
                  "value": "marking premises, information or wayfinding purposes. Most often as non-illuminated signs, information boards, door plates, wayfinding systems and the like."
                },
                {
                  "@type": "PropertyValue",
                  "name": "Variant",
                  "value": "the graphics on the board can be re-applied at any time"
                },
                {
                  "@type": "PropertyValue",
                  "name": "Use",
                  "value": "for signage and orientation in a space"
                }
              ],
              "provider": {
                "@type": "Organization",
                "@id": "https://www.eldr.cz/#organization"
              }
            }
          },
          {
            "@type": "Offer",
